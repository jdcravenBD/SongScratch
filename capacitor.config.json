{
  "appId": "com.songscratch.app",
  "appName": "Song Scratch",
  "webDir": "dist",
  "backgroundColor": "#000000",
  "android": {
    "backgroundColor": "#000000",
    "allowMixedContent": false
  },
  "ios": {
    "backgroundColor": "#000000",
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#000000",
      "showSpinner": false
    }
  }
}
